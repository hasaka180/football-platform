# Copy to .env.local. Never commit real values.

# Production Postgres (Supabase transaction pooler). Leave empty to use the
# local snapshot built by `npm run ingest`.
DATABASE_URL=

# football-data.org free tier key. Optional; enables the current season and UCL.
# Their terms forbid storing keys in open-source repositories.
FOOTBALL_DATA_API_KEY=

# Enables /admin (user "admin"). Unset = /admin returns 404 in production.
ADMIN_PASSWORD=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
